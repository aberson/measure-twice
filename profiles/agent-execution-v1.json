{
  "schema_version": 1,
  "id": "agent-execution-v1",
  "qualification_limits": {
    "agent_timeout_s": 60,
    "evaluator_timeout_s": 30
  },
  "run_policy": {
    "smoke": {
      "limits": {
        "agent_timeout_s": 60,
        "evaluator_timeout_s": 30
      },
      "task_count": 1,
      "model_count": 2,
      "samples": 1,
      "max_cells_per_tranche": 2,
      "terminal_cells": 2,
      "provider_attempts": 4,
      "wall_s": 600
    },
    "pilot": {
      "limits": {
        "agent_timeout_s": 600,
        "evaluator_timeout_s": 60
      },
      "task_count": 12,
      "model_count": 2,
      "samples": 1,
      "max_cells_per_tranche": 24,
      "terminal_cells": 24,
      "provider_attempts": 48,
      "wall_s": 28800
    },
    "observation": {
      "limits": {
        "agent_timeout_s": 600,
        "evaluator_timeout_s": 60
      },
      "task_count": 32,
      "model_count": 2,
      "samples": 3,
      "max_cells_per_tranche": 32,
      "terminal_cells": 192,
      "provider_attempts": 384,
      "wall_s": 28800
    }
  },
  "repetitions": 2,
  "concurrency": 1,
  "ceilings": {
    "changed_paths": 100,
    "patch_bytes": 5242880,
    "stream_bytes_each": 10485760,
    "cell_artifact_bytes": 26214400,
    "evaluator_cpu_s": 60,
    "evaluator_memory_bytes": 1073741824,
    "evaluator_processes": 64,
    "evaluator_files": 10000,
    "evaluator_file_bytes": 10485760
  },
  "retry": {
    "eligible": [
      "rate-limit",
      "provider-5xx",
      "preterminal-transport"
    ],
    "max_fresh_retries": 1,
    "retry_after_cap_s": 60,
    "default_delay_s": 5
  },
  "sandbox_contract_version": "linux-bwrap-v1",
  "schedule_algorithm": "schedule-v1",
  "analysis_algorithm": "bootstrap-v1"
}
